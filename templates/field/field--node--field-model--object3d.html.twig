
{# {{ dump( element['#object'] ) }} #}
{# {{ dump( element['#object'].get('field_width').value ) }} #}

{% set dom_el = element['#object'].get('uuid').value |replace({'-': ''}) %}
{% set width = element['#object'].get('field_width').value %}
{% set height = element['#object'].get('field_height').value %}

<div id="rotating_{{ dom_el }}" class="rotating-ctrl-3" style="
  width: {{ width }}; max-width: 90%;
  height: {{ height }}; max-height: 70%;
  /* background: #cecece; */
  border: 1px solid red;
  text-align: center;
  margin: auto; " >
    <span class="label">Loading...</span>
</div>

<script type="module">

  const dom_id = "rotating_{{ dom_el }}"
  const model_path = "{{ items[0].content }}"

  import * as THREE from 'three';

  import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
  import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';

  import { fitCameraToObject, logg } from 'ish/shared';

  const object_loader = new THREE.ObjectLoader();

  const el = document.getElementById(dom_id);
  const { width, height } = el.getBoundingClientRect();

  let camera, controls, helper, scene, renderer;
  let maxDim;

  init();
  animate();

  function init() {

    const container = document.createElement( 'div' )
    const gltf_loader = new GLTFLoader()
    scene = new THREE.Scene({})

    renderer = new THREE.WebGLRenderer({
      alpha: true,
      antialias: true,
    });
    // renderer.setClearColor( 0x000000, 0 ); // default
    renderer.setPixelRatio( window.devicePixelRatio );
    renderer.setSize( width, height );
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1;
    renderer.outputEncoding = THREE.sRGBEncoding;
    container.appendChild( renderer.domElement );



    /* fov — Camera frustum vertical field of view.
     * aspect — Camera frustum aspect ratio.
     * near — Camera frustum near plane.
     * far — Camera frustum far plane.
    **/
    camera = new THREE.PerspectiveCamera( 45, width/height, 1, 1500 )
    scene.add(camera)

    controls = new OrbitControls( camera, renderer.domElement );
    // controls.addEventListener( 'change', render ); // use if there is no animation loop


    // const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
    // scene.add(ambientLight);

    const dirLight = new THREE.DirectionalLight(0xffffff, 1);
    dirLight.position.set(100, 0, 100);
    dirLight.target.position.set(0, 0, 0);
    helper = new THREE.DirectionalLightHelper(dirLight, 5);
    camera.add(dirLight);
    camera.add(dirLight.target);
    scene.add(helper);


    gltf_loader.load( model_path, function ( gltf ) {
      document.querySelectorAll(`#${dom_id} span.label`).forEach(el => el.style.display = 'none');
      document.getElementById(dom_id).appendChild( container )

      scene.add( gltf.scene )

      maxDim = fitCameraToObject(camera, gltf.scene, controls);
      // logg(maxDim, 'maxDim')
      controls.minDistance = maxDim;
      controls.maxDistance = maxDim*3;
      // controls.update();

      render()
    } );



    controls.target.set( 0, 10, 0 );
    controls.autoRotate = true;
    controls.update();



    window.addEventListener( 'resize', onWindowResize );
  }

  function onWindowResize() {
    camera.aspect = width / height;
    camera.updateProjectionMatrix();
    renderer.setSize( width, height );
    render();
  }

  function render() {
    renderer.render( scene, camera );
  }
  function animate() {
    requestAnimationFrame( animate );
    controls.update();
    renderer.render( scene, camera );
  }
</script>

