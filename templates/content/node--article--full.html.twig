
{%
  set classes = [
    'maxwidth',
    'wco-id-' ~ node.id,
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
  ]
%}
{{ attach_library('ish_drupal_theme/node') }}
<article{{ attributes.addClass(classes) }}>

  <div class='row'>
    <div class='col-2 col-md-1 voteW'>
      {{ content.field_vote_up_down }}
    </div>
    <div class='col-10 col-md-11'>

      {{ title_prefix }}
      {% if label %}
        <h2{{ title_attributes.addClass('title mt-4 ') }}>{{ label }}</h2>
      {% endif %}
      {{ title_suffix }}

      {% if display_submitted %}
        <footer class="node__meta">
          {{ author_picture }}
          <div{{ author_attributes.addClass('node__submitted') }}>
            By {{ author_name }} on {{ node.created.value|date('Y-m-d') }}
            {{ metadata }}
          </div>
        </footer>
      {% endif %}

    </div>
  </div>

  <div class='d-flex mb-2'>
    <div class='mr-2'>
      <a href="{{ content.field_image_thumb.0 }}" data-lightbox="article-thumb" >
        <img style="max-height: 80px;" src="{{ content.field_image_thumb.0 }}" alt='' />
      </a>
    </div>
    <div class='a'>
      <div class="sharethis-inline-share-buttons mb-2"></div>
      {{ content.field_tags }}
      {{ content.field_tags_contrib }}
      {{ content.field_issue }}
      {{ content.field_city }}
      {{ content.field_citytag }}
    </div>
  </div>

  <div class='row'>
    <div class='col-sm-12'>
      <div{{ content_attributes.addClass('node__content') }}>
        {{ content | without('field_city') | without('field_citytag') | without('field_vote_up_down') | without('field_image_hero') | without('field_image_thumb') | without('field_tags') | without('field_tag_contrib') | without('field_tags_contrib') | without('field_issue')| without('field_comments') }}
      </div>
    </div>
  </div>

  <h5 class='center text-center'>Related Articles</h5>
  <div class="row ">
    {% for node in related_articles %}
      <div class="col-6 col-md-3">
        {{ drupal_entity('node', node.id(), 'card') }}
      </div>
    {% endfor %}
  </div>

  {{ content.field_comments }}

  <div class="clearfix"></div>

</article>


